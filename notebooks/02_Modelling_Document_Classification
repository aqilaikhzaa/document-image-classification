    "print(\"\\nSample tensor shape:\", sample_image.shape)\n",
    "print(\"Sample label:\", sample_label)\n",
    "\n",
    "assert sample_image.shape == (3, 224, 224)\n",
    "assert 0 <= sample_label < 16\n",
    "\n",
    "print(\"\\nDataset berhasil diuji!\")"
