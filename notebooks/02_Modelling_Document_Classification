    "# Lokasi best checkpoint\n",
    "BEST_MODEL_PATH = Path(\n",
    "    \"/kaggle/working/checkpoint/best_efficientnet_b0.pth\"\n",
    ")\n",
    "\n",
    "assert BEST_MODEL_PATH.exists(), (\n",
    "    \"Checkpoint tidak ditemukan. \"\n",
    "    \"Pastikan training sudah selesai.\"\n",
    ")\n",
    "\n",
    "# Memuat model terbaik\n",
    "model.load_state_dict(\n",
    "    torch.load(\n",
    "        BEST_MODEL_PATH,\n",
    "        map_location=device,\n",
    "        weights_only=True\n",
    "    )\n",
    ")\n",
    "\n",
    "model.eval()\n",
    "\n",
    "y_true = []\n",
    "y_pred = []\n",
    "\n",
    "# Prediksi data validation\n",
    "with torch.inference_mode():\n",
    "\n",
    "    for images, labels in tqdm(\n",
    "        val_loader,\n",
    "        desc=\"Evaluating validation data\"\n",
    "    ):\n",
    "\n",
    "        images = images.to(\n",
    "            device,\n",
    "            non_blocking=True\n",
    "        )\n",
    "\n",
    "        with torch.autocast(\n",
    "            device_type=device.type,\n",
    "            enabled=device.type == \"cuda\"\n",
    "        ):\n",
    "            outputs = model(images)\n",
    "\n",
    "        predictions = outputs.argmax(dim=1)\n",
    "\n",
    "        y_true.extend(\n",
    "            labels.cpu().numpy().tolist()\n",
    "        )\n",
    "\n",
    "        y_pred.extend(\n",
    "            predictions.cpu().numpy().tolist()\n",
    "        )\n",
    "\n",
    "# Nama 16 kelas sesuai label\n",
    "class_names = (\n",
    "    train_df[[\"label\", \"class_name\"]]\n",
    "    .drop_duplicates()\n",
    "    .sort_values(\"label\")[\"class_name\"]\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "labels_order = list(range(16))\n",
    "\n",
    "# Menghitung accuracy\n",
    "val_accuracy = accuracy_score(y_true, y_pred)\n",
    "\n",
    "print(\"=\" * 55)\n",
    "print(\"EFFICIENTNET-B0 VALIDATION EVALUATION\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "print(f\"Validation Accuracy: {val_accuracy * 100:.2f}%\")\n",
    "\n",
    "# Classification report\n",
    "report_dict = classification_report(\n",
    "    y_true,\n",
    "    y_pred,\n",
    "    labels=labels_order,\n",
    "    target_names=class_names,\n",
    "    digits=4,\n",
    "    zero_division=0,\n",
    "    output_dict=True\n",
    ")\n",
    "\n",
    "report_df = pd.DataFrame(report_dict).T\n",
    "\n",
    "print(\"\\nClassification Report:\")\n",
    "display(report_df.round(4))\n",
    "\n",
    "# Simpan classification report\n",
    "report_df.to_csv(\n",
    "    EVAL_DIR / \"classification_report.csv\"\n",
    ")\n",
    "\n",
    "# Confusion Matrix\n",
    "cm = confusion_matrix(\n",
    "    y_true,\n",
    "    y_pred,\n",
    "    labels=labels_order\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(15, 13))\n",
    "\n",
    "disp = ConfusionMatrixDisplay(\n",
    "    confusion_matrix=cm,\n",
    "    display_labels=class_names\n",
    ")\n",
    "\n",
    "disp.plot(\n",
    "    ax=ax,\n",
    "    cmap=\"Blues\",\n",
    "    xticks_rotation=90,\n",
    "    values_format=\"d\",\n",
    "    colorbar=False\n",
    ")\n",
    "\n",
    "ax.set_title(\n",
    "    \"EfficientNet-B0 - Validation Confusion Matrix\",\n",
    "    fontsize=15\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "    EVAL_DIR / \"confusion_matrix.png\",\n",
    "    dpi=180,\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nEvaluation files saved!\")\n",
    "print(\"Location:\", EVAL_DIR)"
