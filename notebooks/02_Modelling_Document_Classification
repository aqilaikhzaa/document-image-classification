   "source": [
    "IMG_SIZE = 224\n",
    "\n",
    "class ResizeWithPadding:\n",
    "    \"\"\"\n",
    "    Mengubah ukuran gambar tanpa mengubah rasio aspek.\n",
    "\n",
    "    Gambar diskalakan agar muat ke dalam kanvas persegi,\n",
    "    kemudian ditambahkan padding putih.\n",
    "\n",
    "    Args:\n",
    "        size (int): Ukuran sisi akhir gambar.\n",
    "\n",
    "    Returns:\n",
    "        PIL.Image.Image: Gambar RGB persegi.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, size=224):\n",
    "        self.size = size\n",
    "\n",
    "    def __call__(self, image):\n",
    "        image = image.convert(\"RGB\")\n",
    "\n",
    "        # Mempertahankan aspect ratio\n",
    "        img = ImageOps.contain(\n",
    "            image,\n",
    "            (self.size, self.size),\n",
    "            method=Image.Resampling.BILINEAR\n",
    "        )\n",
    "\n",
    "        # Padding putih\n",
    "        canvas = Image.new(\n",
    "            \"RGB\",\n",
    "            (self.size, self.size),\n",
    "            (255, 255, 255)\n",
    "        )\n",
    "\n",
    "        x = (self.size - img.width) // 2\n",
    "        y = (self.size - img.height) // 2\n",
    "\n",
    "        canvas.paste(img, (x, y))\n",
    "\n",
    "        return canvas\n",
    "\n",
    "\n",
    "print(\"ResizeWithPadding berhasil dibuat.\")"
   ]
