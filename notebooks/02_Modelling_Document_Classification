    "\n",
    "    ax = axes.flat[i]\n",
    "    ax.imshow(denormalize_image(image))\n",
    "    ax.set_title(f\"Label {label}\")\n",
    "    ax.axis(\"off\")\n",
    "\n",
    "plt.suptitle(\n",
    "    \"Document Images After Preprocessing\",\n",
