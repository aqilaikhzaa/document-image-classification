    "def train_one_epoch(\n",
    "    model,\n",
    "    loader,\n",
    "    criterion,\n",
    "    optimizer,\n",
    "    device,\n",
    "    scaler\n",
    "):\n",
    "    \"\"\"\n",
    "    Melatih model selama satu epoch menggunakan PyTorch.\n",
    "\n",
    "    Args:\n",
    "        model (nn.Module): Model klasifikasi dokumen.\n",
    "        loader (DataLoader): DataLoader training.\n",
    "        criterion (nn.Module): Fungsi loss.\n",
    "        optimizer (Optimizer): Optimizer model.\n",
    "        device (torch.device): CPU atau GPU.\n",
    "        scaler (GradScaler): Pengelola AMP gradient scaling.\n",
    "\n",
    "    Returns:\n",
    "        tuple: Rata-rata training loss dan accuracy (%).\n",
    "    \"\"\"\n",
    "    model.train()\n",
    "\n",
    "    running_loss = 0.0\n",
    "    correct = 0\n",
    "    total = 0\n",
    "\n",
    "    progress = tqdm(loader, desc=\"Training\", leave=False)\n",
    "\n",
    "    for images, labels in progress:\n",
    "        images = images.to(device, non_blocking=True)\n",
    "        labels = labels.to(device, non_blocking=True)\n",
    "\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "\n",
    "        with torch.autocast(\n",
    "            device_type=device.type,\n",
    "            enabled=device.type == \"cuda\"\n",
    "        ):\n",
    "            outputs = model(images)\n",
    "            loss = criterion(outputs, labels)\n",
    "\n",
    "        scaler.scale(loss).backward()\n",
    "        scaler.step(optimizer)\n",
    "        scaler.update()\n",
    "\n",
    "        predictions = outputs.argmax(dim=1)\n",
    "\n",
    "        batch_size = labels.size(0)\n",
    "        running_loss += loss.item() * batch_size\n",
    "        correct += (predictions == labels).sum().item()\n",
    "        total += batch_size\n",
    "\n",
    "        progress.set_postfix(\n",
    "            loss=f\"{running_loss / total:.4f}\",\n",
    "            acc=f\"{100 * correct / total:.2f}%\"\n",
    "        )\n",
    "\n",
    "    return running_loss / total, 100 * correct / total\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def validate_one_epoch(\n",
    "    model,\n",
    "    loader,\n",
    "    criterion,\n",
    "    device\n",
    "):\n",
    "    \"\"\"\n",
    "    Mengevaluasi model pada data validation.\n",
