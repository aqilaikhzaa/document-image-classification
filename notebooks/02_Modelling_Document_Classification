    "class DocumentDataset(Dataset):\n",
    "    \"\"\"\n",
    "    Dataset PyTorch untuk klasifikasi gambar dokumen TIFF.\n",
    "\n",
    "    Args:\n",
    "        dataframe (pd.DataFrame):\n",
    "            Metadata gambar yang memiliki filename dan label.\n",
    "        data_dir (Path):\n",
    "            Direktori utama dataset kompetisi.\n",
    "        transform (callable, optional):\n",
    "            Transformasi preprocessing gambar.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        dataframe,\n",
    "        data_dir,\n",
    "        transform=None\n",
    "    ):\n",
    "        self.df = dataframe.reset_index(drop=True)\n",
    "        self.data_dir = Path(data_dir)\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        \"\"\"Mengembalikan jumlah sampel dataset.\"\"\"\n",
    "        return len(self.df)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        \"\"\"\n",
    "        Membaca gambar dan label berdasarkan indeks.\n",
    "\n",
    "        Args:\n",
    "            idx (int): Indeks sampel.\n",
    "\n",
    "        Returns:\n",
    "            tuple: Tensor gambar dan label integer.\n",
    "        \"\"\"\n",
    "        row = self.df.iloc[idx]\n",
    "\n",
    "        # Metadata: train/resume/nama.tif\n",
    "        # Path aktual: train/train/resume/nama.tif\n",
    "        image_path = (\n",
    "            self.data_dir / \"train\" / row[\"filename\"]\n",
    "        )\n",
    "\n",
    "        with Image.open(image_path) as img:\n",
    "            image = img.convert(\"RGB\")\n",
    "\n",
    "        if self.transform:\n",
    "            image = self.transform(image)\n",
    "\n",
    "        label = int(row[\"label\"])\n",
    "\n",
    "        return image, label\n",
    "\n",
    "\n",
    "train_dataset = DocumentDataset(\n",
    "    dataframe=train_data,\n",
    "    data_dir=DATA_DIR,\n",
    "    transform=train_transform\n",
    ")\n",
    "\n",
    "val_dataset = DocumentDataset(\n",
    "    dataframe=val_data,\n",
    "    data_dir=DATA_DIR,\n",
    "    transform=val_transform\n",
    ")\n",
    "\n",
    "print(\"Train dataset:\", len(train_dataset))\n",
    "print(\"Validation dataset:\", len(val_dataset))\n",
    "\n",
    "# Uji satu gambar\n",
    "sample_image, sample_label = train_dataset[0]\n",
