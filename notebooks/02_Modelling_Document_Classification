    "def audit_image_files(dataframe, data_dir):\n",
    "    \"\"\"\n",
    "    Memeriksa integritas gambar TIFF dalam dataframe.\n",
    "\n",
    "    Args:\n",
    "        dataframe (pd.DataFrame): Metadata gambar.\n",
    "        data_dir (Path): Direktori dataset kompetisi.\n",
    "\n",
    "    Returns:\n",
    "        tuple: Dataframe file valid dan dataframe file rusak.\n",
    "    \"\"\"\n",
    "    valid_indices = []\n",
    "    bad_records = []\n",
    "\n",
    "    for idx, row in tqdm(\n",
    "        dataframe.iterrows(),\n",
    "        total=len(dataframe),\n",
    "        desc=\"Checking TIFF integrity\"\n",
    "    ):\n",
    "        path = Path(data_dir) / \"train\" / row[\"filename\"]\n",
    "\n",
    "        try:\n",
    "            with Image.open(path) as img:\n",
    "                img.load()\n",
    "                if img.width <= 0 or img.height <= 0:\n",
    "                    raise ValueError(\"Invalid image dimensions\")\n",
    "\n",
    "            valid_indices.append(idx)\n",
    "\n",
    "        except Exception as error:\n",
    "            bad_records.append({\n",
    "                \"id\": row[\"id\"],\n",
    "                \"filename\": row[\"filename\"],\n",
    "                \"label\": row[\"label\"],\n",
    "                \"error_type\": type(error).__name__,\n",
    "                \"error\": str(error)\n",
    "            })\n",
    "\n",
    "    valid_df = dataframe.loc[\n",
    "        valid_indices\n",
    "    ].reset_index(drop=True)\n",
    "\n",
    "    bad_df = pd.DataFrame(\n",
    "        bad_records,\n",
    "        columns=[\n",
    "            \"id\", \"filename\", \"label\",\n",
    "            \"error_type\", \"error\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    return valid_df, bad_df\n",
    "\n",
    "\n",
    "# Audit seluruh data training berlabel\n",
    "clean_train_df, corrupted_df = audit_image_files(\n",
    "    train_df,\n",
    "    DATA_DIR\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 50)\n",
    "print(\"IMAGE INTEGRITY REPORT\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "print(\"Original images :\", len(train_df))\n",
    "print(\"Valid images    :\", len(clean_train_df))\n",
    "print(\"Corrupted images:\", len(corrupted_df))\n",
    "\n",
    "display(corrupted_df.head(20))\n",
    "\n",
    "# Simpan daftar gambar rusak\n",
    "corrupted_df.to_csv(\n",
    "    \"/kaggle/working/corrupted_images.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\nAudit selesai.\")"
   ]
